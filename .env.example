# Copy to .env and fill in. Never commit .env.
# None of these are needed for the offline path (make ingest / make test).

# Required only for `make fetch` (re-recording fixtures). Free key: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
# Optional: archive RPC used to cross-check balances at the snapshot block (e.g. Alchemy free tier)
ETH_RPC_URL=

# Optional overrides
# DAO_CONFIG=config/dao.uniswap.yaml
# DB_PATH=data/treasury.duckdb
# ETHERSCAN_RPS=2.5

# LLM: any OpenAI-compatible provider. Only needed for live questions and `make eval-live`.
# The offline eval replays recorded model responses and needs no key.
LLM_PROVIDER=gemini            # gemini | groq | openrouter
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=                # free: https://aistudio.google.com/apikey
GROQ_API_KEY=                  # free: https://console.groq.com/keys
